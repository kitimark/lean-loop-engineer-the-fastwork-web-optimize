{
  "name": "@fw/e2e-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end suite of the console preview (/r, /o, /compare through the real preview proxy), Chromium and WebKit, over loopback and a plain-HTTP host.",
  "engines": { "node": ">=24" },
  "scripts": {
    "e2e": "node src/run.mjs",
    "test": "node ../../scripts/slot-self.mjs test -- pnpm run test:run",
    "test:run": "node --test --test-concurrency=${VITEST_MAX_WORKERS:-$(node -p \"require('../contracts/golden/sched/node-budget.gen.json').workers\")} \"test/*.test.mjs\""
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
