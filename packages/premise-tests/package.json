{
  "name": "@fw/premise-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One browser test per empirical premise a Lean theorem relies on (registry: lean/Fw/Ops/Premise.lean), run on Chromium and WebKit.",
  "engines": { "node": ">=24" },
  "scripts": {
    "premises": "node src/run.mjs",
    "test": "node ../../scripts/slot-self.mjs test -- pnpm run test:run",
    "test:run": "node --test --test-concurrency=${VITEST_MAX_WORKERS:-$(node -p \"require('../contracts/golden/sched/node-budget.gen.json').workers\")} \"test/*.test.mjs\""
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
