{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "now": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "stage": {
            "type": "string",
            "enum": [
              "question",
              "build",
              "screen",
              "review",
              "device",
              "land_ready",
              "land"
            ]
          },
          "next": {
            "type": "object",
            "properties": {
              "who": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            },
            "required": [
              "who",
              "command"
            ],
            "additionalProperties": false
          },
          "lastAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "needsYou": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "action": {
                    "type": "string"
                  }
                },
                "required": [
                  "step",
                  "title",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "runningRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "head": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "landed": {
            "type": "boolean"
          },
          "violation": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "owner",
          "stage",
          "next",
          "lastAt",
          "needsYou",
          "runningRuns",
          "head",
          "landed",
          "violation",
          "stale"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "card": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "action",
              "yes_no",
              "choice",
              "text"
            ]
          },
          "options": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "started",
              "answered",
              "done",
              "cancelled"
            ]
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "postedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "card",
          "title",
          "kind",
          "options",
          "status",
          "answer",
          "postedAt",
          "lastAt"
        ],
        "additionalProperties": false
      }
    },
    "needsYou": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "title",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string"
              },
              "stream": {
                "type": "string"
              },
              "milestone": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "owner": {
                "type": "string"
              },
              "deps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "lane": {
                "type": "string",
                "enum": [
                  "agent",
                  "device"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "done",
                  "cut",
                  "running",
                  "quiet",
                  "handedBack",
                  "integrated",
                  "parked",
                  "ready",
                  "blocked"
                ]
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "agent": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "since": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "at"
                  ],
                  "additionalProperties": false
                }
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "handedBack"
                          },
                          "agent": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "tip": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "agent",
                          "tip"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "integrated"
                          },
                          "branch": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "tip": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "branch",
                          "tip"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "parked"
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "stream",
              "milestone",
              "owner",
              "deps",
              "needs",
              "lane",
              "state",
              "blockers",
              "agent",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string"
              },
              "done": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "title",
              "done",
              "total"
            ],
            "additionalProperties": false
          }
        },
        "criticalPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "parallelSafe": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      },
      "required": [
        "tasks",
        "milestones",
        "criticalPath",
        "parallelSafe"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "now",
    "cards",
    "steps",
    "needsYou",
    "plan"
  ],
  "additionalProperties": false
}
