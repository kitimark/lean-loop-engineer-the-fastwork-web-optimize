{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "now": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "stage": {
            "type": "string",
            "enum": [
              "question",
              "build",
              "screen",
              "review",
              "device",
              "land_ready",
              "land"
            ]
          },
          "next": {
            "type": "object",
            "properties": {
              "who": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            },
            "required": [
              "who",
              "command"
            ],
            "additionalProperties": false
          },
          "lastAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "needsYou": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "action": {
                    "type": "string"
                  }
                },
                "required": [
                  "step",
                  "title",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "runningRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "head": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "landed": {
            "type": "boolean"
          },
          "violation": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "owner",
          "stage",
          "next",
          "lastAt",
          "needsYou",
          "runningRuns",
          "head",
          "landed",
          "violation",
          "stale"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "card": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "action",
              "yes_no",
              "choice",
              "text"
            ]
          },
          "options": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "started",
              "answered",
              "done",
              "cancelled"
            ]
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "postedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "audience": {
            "type": "string",
            "enum": [
              "user",
              "lead"
            ]
          },
          "body": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "card",
          "title",
          "kind",
          "options",
          "status",
          "answer",
          "postedAt",
          "lastAt",
          "audience",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "needsYou": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "title",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "seq",
    "now",
    "cards",
    "steps",
    "needsYou"
  ],
  "additionalProperties": false
}
