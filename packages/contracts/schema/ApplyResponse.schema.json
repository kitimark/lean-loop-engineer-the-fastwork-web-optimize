{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "object",
      "properties": {
        "seen": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "needsDevice": {
                "type": "boolean"
              },
              "approved": {
                "type": "boolean"
              },
              "head": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "builders": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "screenAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewedBy": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deviceAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landReq": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landed": {
                "type": "boolean"
              },
              "violation": {
                "type": "boolean"
              },
              "lastAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "owner",
              "needsDevice",
              "approved",
              "head",
              "builders",
              "screenAt",
              "reviewAt",
              "reviewedBy",
              "deviceAt",
              "landReq",
              "landed",
              "violation",
              "lastAt"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "card": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": [
                  "action",
                  "yes_no",
                  "choice",
                  "text"
                ]
              },
              "options": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "waiting",
                  "started",
                  "answered",
                  "done",
                  "cancelled"
                ]
              },
              "answer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "postedAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audience": {
                "type": "string",
                "enum": [
                  "user",
                  "lead"
                ]
              },
              "body": {
                "type": "string",
                "maxLength": 2000
              },
              "topic": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "card",
              "title",
              "kind",
              "options",
              "status",
              "answer",
              "postedAt",
              "lastAt",
              "audience",
              "body"
            ],
            "additionalProperties": false
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "card": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "type": "string",
                "enum": [
                  "screen",
                  "gate",
                  "run",
                  "device"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "passed",
                  "failed"
                ]
              },
              "startedAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "card",
              "kind",
              "status",
              "startedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "seen",
        "cards",
        "steps",
        "runs"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "boolean",
              "const": true
            },
            "duplicate": {
              "type": "boolean"
            }
          },
          "required": [
            "accepted",
            "duplicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "accepted",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "state",
    "outcome"
  ],
  "additionalProperties": false
}
