{"name":"the wait doubles: second failure, wait 4 s","request":{"attempt":2,"error":"simctl launch Safari failed: ETIMEDOUT","max":3,"op":"measure.retry"},"response":{"class":"transient","delayMs":4000,"retry":true}}
{"name":"the limit is reached: not retried even though transient","request":{"attempt":3,"error":"ETIMEDOUT","max":3,"op":"measure.retry"},"response":{"class":"transient","delayMs":0,"retry":false}}
{"name":"boot message from simctl is transient, case ignored","request":{"attempt":1,"error":"simctl boot failed: UNABLE TO BOOT device in current state: Booted","max":3,"op":"measure.retry"},"response":{"class":"transient","delayMs":2000,"retry":true}}
{"name":"device busy is transient","request":{"attempt":1,"error":"Device busy, try again","max":2,"op":"measure.retry"},"response":{"class":"transient","delayMs":2000,"retry":true}}
