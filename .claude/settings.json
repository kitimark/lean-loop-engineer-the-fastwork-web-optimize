{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "BASH_MAX_OUTPUT_LENGTH": "16000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000",
    "CLAUDE_CODE_WEBFETCH_DEADLINE_MS": "600000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "teammateMode": "in-process",
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/emit.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(pnpm fw *)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/cap.mjs"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/spawn-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/apps/runner/hooks/wait-guard.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(brew info *)",
      "Bash(brew list*)",
      "Bash(lake build*)",
      "Bash(lake env lean *)",
      "Bash(lake test*)",
      "Bash(lake exe *)",
      "Bash(lake update*)",
      "Bash(xcrun simctl list*)",
      "Bash(gh repo clone *)",
      "Bash(gh search code *)",
      "Bash(gh search repos *)",
      "Bash(gh auth status*)",
      "Bash(git push origin main)",
      "Bash(git push origin ci/*)",
      "Bash(git push -u origin ci/*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh run download*)",
      "Bash(gh workflow list*)",
      "Bash(curl -fsSL https://raw.githubusercontent.com/*)",
      "Bash(curl -sL https://raw.githubusercontent.com/*)",
      "Bash(node scripts/refs-fetch.mjs*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:chromium.googlesource.com)",
      "WebFetch(domain:source.chromium.org)",
      "WebFetch(domain:webkit.org)",
      "WebFetch(domain:lean-lang.org)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:code.claude.com)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_declaration",
      "mcp__lean-lsp__lean_goal",
      "mcp__lean-lsp__lean_term_goal",
      "mcp__lean-lsp__lean_diagnostic_messages",
      "mcp__lean-lsp__lean_hover_info",
      "mcp__lean-lsp__lean_local_search",
      "mcp__lean-lsp__lean_declaration_file",
      "mcp__lean-lsp__lean_references",
      "mcp__lean-lsp__lean_file_outline"
    ],
    "ask": [
      "Bash(git remote add *)",
      "Bash(git config remote.*)",
      "Agent(model:*fable*)",
      "Agent(general-purpose)",
      "Agent(fork)",
      "CronCreate",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Bash(find / *)",
      "Bash(find /Users *)",
      "Bash(git push*:*main*)",
      "Bash(git push*main *)",
      "Bash(git push*--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push*--delete*)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",
      "Bash(git push*+*)",
      "Bash(git -C * push*)",
      "Bash(git add -f *)",
      "Bash(git add --force*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git -C ../fastwork-com-web-optimize *)",
      "Bash(gh api*)",
      "Bash(gh pr *)",
      "Bash(gh repo create*)",
      "Bash(gh release*)",
      "Bash(gh gist*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Edit(/.local/**)"
    ]
  }
}
