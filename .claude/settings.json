{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "teammateMode": "in-process",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(brew info *)",
      "Bash(brew list*)",
      "Bash(lake build*)",
      "Bash(lake env lean *)",
      "Bash(xcrun simctl list*)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_declaration"
    ],
    "ask": [
      "Bash(git remote add *)",
      "Bash(git config remote.*)",
      "Agent(model:fable)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git add -f *)",
      "Bash(git add --force*)",
      "Bash(git commit*--no-verify*)",
      "Bash(gh pr create*)",
      "Bash(gh repo create*)",
      "Bash(gh release*)",
      "Bash(gh gist*)",
      "Edit(/.local/**)",
      "Write(/.local/**)",
      "Edit(/../fastwork-com-web-optimize/**)",
      "Write(/../fastwork-com-web-optimize/**)"
    ]
  }
}
