/-!
# Which generator a command line runs: `breakgen` and `sweepsgen` (task `site-build-cache`)

Until this task one executable, `breakgen`, printed or checked three generated files: the site's
`breakpoints.gen.json` (`Fw.Site.BreakpointGen.run`), the gate's `sweeps.gen.json` / `golden/gate/sweeps.jsonl`
(`Fw.Gate.SweepsGen.run`, flags `--sweeps` / `--sweeps-golden`) and the gate's `scope.gen.json`
(`Fw.Gate.ScopeGen.run`, flag `--scope`). The site build runs `lake exe breakgen --check`, so it had to build the
import cone of all three (Fw.Gate.Scope, the wire, the console, the plan: 38 modules, 26-50 s on CI when the
restored Lake entry lacked them, research/notes/2026/10-18-slow-site-build.md).

Now `breakgen` (root `BreakgenMain`) imports only `Fw.Site.BreakpointGen`, and `sweepsgen` (root `SweepsgenMain`)
runs the two gate generators. This module is the routing both roots share; it imports nothing, so it adds nothing
to the site build's cone. `split_agrees` proves that each old `breakgen` command line reaches the same generator through
`breakgen` or `sweepsgen`. Both mains pass it `argsFor g args`, the argument rule of the old main, so the
arguments match by construction. That the generated bytes are unchanged is a premise, not a theorem: the generators'
`run` functions are untouched, and `lean/scripts/check.sh` compares every output with the checked-in files.
-/
namespace Fw.Site.GenRoute

/-- The three generators.
$$\mathrm{Gen} = \{\mathrm{breakpoints},\ \mathrm{sweeps},\ \mathrm{scope}\}$$ -/
inductive Gen
  | breakpoints
  | sweeps
  | scope
deriving DecidableEq, Repr

/-- The command line contains a flag that names a gate generator.
$$\operatorname{gate}(a) \iff \texttt{--scope} \in a \lor \texttt{--sweeps} \in a \lor \texttt{--sweeps-golden} \in a$$ -/
def gateFlag (args : List String) : Bool :=
  args.contains "--scope" || args.contains "--sweeps" || args.contains "--sweeps-golden"

/-- The route of the old single `breakgen` (BreakgenMain.lean before this task): `--scope` first, then the sweeps
flags, else the breakpoints.
$$\operatorname{old}(a) = \begin{cases} \mathrm{scope} & \texttt{--scope} \in a \\ \mathrm{sweeps} & \text{else if } \texttt{--sweeps} \in a \lor \texttt{--sweeps-golden} \in a \\ \mathrm{breakpoints} & \text{otherwise} \end{cases}$$ -/
def oldRoute (args : List String) : Gen :=
  if args.contains "--scope" then .scope
  else if args.contains "--sweeps" || args.contains "--sweeps-golden" then .sweeps
  else .breakpoints

/-- The arguments a generator's `run` receives (as before: `--scope` is removed for the scope generator, every other
generator gets the command line as it is).
$$\operatorname{argsFor}(g, a) = \begin{cases} [\,x \in a : x \ne \texttt{--scope}\,] & g = \mathrm{scope} \\ a & \text{otherwise} \end{cases}$$ -/
def argsFor : Gen → List String → List String
  | .scope, args => args.filter (· != "--scope")
  | _, args => args

/-- The new `breakgen`: the breakpoints generator, or nothing when the command line names a gate generator (on
nothing, `BreakgenMain.lean` prints a pointer to `sweepsgen` and exits 2).
$$\operatorname{bg}(a) = \begin{cases} \bot & \operatorname{gate}(a) \\ \mathrm{breakpoints} & \text{otherwise} \end{cases}$$ -/
def breakgenRoute (args : List String) : Option Gen :=
  if gateFlag args then none else some .breakpoints

/-- The new `sweepsgen`: the scope generator on `--scope`, else the sweeps generator (`--sweeps-golden` selects the
golden inside `Fw.Gate.SweepsGen.run`; no flag means `--sweeps`).
$$\operatorname{sg}(a) = \begin{cases} \mathrm{scope} & \texttt{--scope} \in a \\ \mathrm{sweeps} & \text{otherwise} \end{cases}$$ -/
def sweepsgenRoute (args : List String) : Gen :=
  if args.contains "--scope" then .scope else .sweeps

#guard breakgenRoute [] == some .breakpoints
#guard breakgenRoute ["--check", "src/breakpoints.gen.json"] == some .breakpoints
#guard breakgenRoute ["--inventory", "i.json", "--check", "f"] == some .breakpoints
#guard breakgenRoute ["--sweeps"] == none
#guard breakgenRoute ["--sweeps-golden", "--check", "f"] == none
#guard breakgenRoute ["--scope"] == none
#guard sweepsgenRoute ["--sweeps", "--check", "f"] == .sweeps
#guard sweepsgenRoute ["--sweeps-golden"] == .sweeps
#guard sweepsgenRoute [] == .sweeps
#guard sweepsgenRoute ["--scope", "--check", "f"] == .scope
#guard argsFor .scope ["--scope", "--check", "f"] == ["--check", "f"]
#guard argsFor .sweeps ["--sweeps", "--check", "f"] == ["--sweeps", "--check", "f"]
#guard oldRoute ["--scope", "--sweeps"] == .scope

/-- **`breakgen` keeps the breakpoints.** Every command line the old `breakgen` sent to the breakpoints generator, the
new `breakgen` sends there too.
$$\forall a:\ \operatorname{old}(a) = \mathrm{breakpoints} \Rightarrow \operatorname{bg}(a) = \mathrm{breakpoints}$$ -/
theorem breakgen_keeps (args : List String) (h : oldRoute args = .breakpoints) :
    breakgenRoute args = some .breakpoints := by
  unfold oldRoute at h; unfold breakgenRoute gateFlag
  cases hs : args.contains "--scope" <;> cases hw : args.contains "--sweeps" <;>
    cases hg : args.contains "--sweeps-golden" <;> simp_all

/-- **`sweepsgen` takes the gate generators.** Every command line the old `breakgen` sent to a gate generator,
`sweepsgen` sends to the same generator.
$$\forall a:\ \operatorname{old}(a) \ne \mathrm{breakpoints} \Rightarrow \operatorname{sg}(a) = \operatorname{old}(a)$$ -/
theorem sweepsgen_takes (args : List String) (h : oldRoute args ≠ .breakpoints) :
    sweepsgenRoute args = oldRoute args := by
  unfold oldRoute at h ⊢; unfold sweepsgenRoute
  cases hs : args.contains "--scope" <;> cases hw : args.contains "--sweeps" <;>
    cases hg : args.contains "--sweeps-golden" <;> simp_all

/-- **`breakgen` never runs a gate generator.** Whatever the new `breakgen` runs is the breakpoints generator, and the
old route agreed.
$$\forall a, g:\ \operatorname{bg}(a) = g \Rightarrow g = \mathrm{breakpoints} \land \operatorname{old}(a) = \mathrm{breakpoints}$$ -/
theorem breakgen_only_breakpoints (args : List String) (g : Gen) (h : breakgenRoute args = some g) :
    g = .breakpoints ∧ oldRoute args = .breakpoints := by
  unfold breakgenRoute gateFlag at h; unfold oldRoute
  cases hs : args.contains "--scope" <;> cases hw : args.contains "--sweeps" <;>
    cases hg : args.contains "--sweeps-golden" <;> simp_all

/-- **The split agrees with the old executable.** For every command line, the new pair (run `breakgen`; on a gate flag
run `sweepsgen` instead) reaches the generator the old `breakgen` chose. (The arguments match because both mains use
`argsFor`; the outputs match only on the premise that the generators' `run` functions are unchanged, which
`lean/scripts/check.sh` tests by diffing every output.)
$$\forall a:\ \operatorname{route}(a) = \operatorname{old}(a),\quad \operatorname{route}(a) = \begin{cases} \operatorname{sg}(a) & \operatorname{bg}(a) = \bot \\ g & \operatorname{bg}(a) = g \end{cases}$$ -/
theorem split_agrees (args : List String) :
    (match breakgenRoute args with
      | some g => g
      | none => sweepsgenRoute args) = oldRoute args := by
  unfold breakgenRoute gateFlag sweepsgenRoute oldRoute
  cases hs : args.contains "--scope" <;> cases hw : args.contains "--sweeps" <;>
    cases hg : args.contains "--sweeps-golden" <;> simp

end Fw.Site.GenRoute
