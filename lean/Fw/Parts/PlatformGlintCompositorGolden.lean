import Lean.Data.Json
import Fw.Parts.PlatformGlintCompositor
/-! Golden vectors and the site keyframes for `platform.glint:compositor`
(`packages/contracts/golden/parts/platform-glint-compositor.jsonl`, `apps/site/src/parts/platform.glint/compositor.gen.ts`). -/
namespace Fw.Parts.PlatformGlintCompositorGolden
open Lean Fw.Parts.PlatformGlint Fw.Parts.PlatformGlintCompositor

/-- A rational whose denominator divides 10 as a JSON decimal; every value here is a multiple of 1/5 or an integer. -/
def numJ (q : Rat) : Json := if q.den = 1 then .num q.num else .num ⟨q.num * 10 / q.den, 1⟩

#guard (numJ (3 / 5)).compress == "0.6"
#guard stopOffsets.all fun (o : Rat) => 10 % o.den == 0 && (o.num * 10) % o.den == 0

def sideName : Side → String
  | .left => "left"
  | .right => "right"

/-- The CSS keyframes of a side: offset `k/5`, translation px. -/
def keyframes (s : Side) : Json :=
  .arr ((List.range 6).map fun (k : Nat) =>
    Json.mkObj [("offset", numJ ((k : Rat) / 5)), ("tx", numJ (shiftAt s ((k : Rat) / 5)))]).toArray

def stopsJ (f : Rat → Rat) : Json := .arr (stopOffsets.map fun o => numJ (f o)).toArray

def constJson : Json :=
  Json.mkObj [("durMs", numJ dur), ("easing", "linear"), ("layerLeft", numJ layerLeft), ("layerWidth", numJ layerWidth),
    ("stopOffsets", .arr (stopOffsets.map numJ).toArray)]

def elapsedSamples : List Rat :=
  [0, 250, 500, 999, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500, 4999, 5000, 5250, 7500, 12345, 3600000]

def stopsLine (s : Side) (e : Rat) : String :=
  (Json.mkObj [("fn", "glint.compositor.stops"), ("in", Json.mkObj [("side", .str (sideName s)), ("elapsed", numJ e)]),
    ("out", Json.mkObj [("orig", stopsJ (origStop s e)), ("variant", stopsJ (varStop s e))])]).compress

def lines (_ : Unit) : List String :=
  [(Json.mkObj [("fn", "glint.compositor.const"), ("in", Json.mkObj []), ("out", constJson)]).compress] ++
    [Side.left, Side.right].map (fun s =>
      (Json.mkObj [("fn", "glint.compositor.keyframes"), ("in", Json.mkObj [("side", .str (sideName s))]),
        ("out", keyframes s)]).compress) ++
    (([Side.left, Side.right].map fun s => elapsedSamples.map (stopsLine s)).flatten) ++
    [(Json.mkObj [("fn", "glint.compositor.set"), ("in", Json.mkObj []),
      ("out", Json.mkObj [("variantSmil", .num (variantSet.filter (· == Kind.smilAttr)).length),
        ("variantWrites", .num (variantSet.map writesPerFrame).sum), ("faithfulWrites", .num (faithfulSet.map writesPerFrame).sum)])]).compress]

#guard (lines ()).length == 1 + 2 + 2 * elapsedSamples.length + 1

def goldenText (_ : Unit) : String := "\n".intercalate (lines ()) ++ "\n"

/-- The site module: the same JSON as a default export (the scanner of parts reads `.ts`). -/
def siteJson (_ : Unit) : String :=
  "// Generated by lean/Fw/Parts/PlatformGlintCompositorGolden.lean (never edit by hand).\nexport default " ++ (Json.mkObj [("durMs", numJ dur), ("easing", "linear"), ("layerLeft", numJ layerLeft), ("layerWidth", numJ layerWidth),
    ("stopOffsets", .arr (stopOffsets.map numJ).toArray), ("keyframes", Json.mkObj [("left", keyframes .left), ("right", keyframes .right)])]).compress ++ ";\n"

def gen (args : List String) : IO Unit := do
  let path := "../packages/contracts/golden/parts/platform-glint-compositor.jsonl"
  let site := "../apps/site/src/parts/platform.glint/compositor.gen.ts"
  if args.contains "--check" then
    let disk ← IO.FS.readFile path
    let diskSite ← IO.FS.readFile site
    if disk != goldenText () || diskSite != siteJson () then
      throw (IO.userError s!"platform-glint-compositor: {path} or {site} is stale; regenerate with Fw.Parts.PlatformGlintCompositorGolden.gen []")
    IO.println s!"platform-glint-compositor: {path} and {site} equal the Lean output, {(lines ()).length} lines"
  else
    IO.FS.writeFile path (goldenText ())
    IO.FS.writeFile site (siteJson ())

end Fw.Parts.PlatformGlintCompositorGolden
