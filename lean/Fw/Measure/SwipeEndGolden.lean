import Lean.Data.Json
import Fw.Measure.SwipeEnd

namespace Fw.Measure.SwipeEndGolden
open Fw.Measure.SwipeEnd Fw.Measure.Profile Fw.Measure.OffscreenWindows Lean

def swipes : List Swipe :=
  [swipeTouchV1, ⟨10, 0, 10, 0, 0⟩, ⟨500, 100, 25, 0, 0⟩, ⟨880, 100, 10, 2, 3⟩, ⟨880, 100, 10, 60, 2⟩]

def swipeJson (s : Swipe) : Json :=
  Json.mkObj [("startY", s.startY), ("minY", s.minY), ("dyPerFrame", s.dy), ("holdFrames", s.holdFrames), ("gapFrames", s.gapFrames)]

def stopCases : List (Nat × Nat) :=
  [(575, 575), (575, 739), (575, 700), (575, 740), (575, 800), (671, 671), (0, 0), (0, 164), (10, 300)]

def stopsCases : List (Nat × Nat × Bool) :=
  [(575, 574, true), (575, 739, true), (575, 740, true), (575, 739, false), (575, 740, false), (575, 741, true), (671, 835, true), (671, 836, true), (671, 836, false)]

def endFrameCases : List (Nat × Nat) := [(575, 0), (739, 164), (671, 0), (10, 10), (5, 9)]

def reasonCases : List (Nat × Nat) := [(5346, 5346), (5346, 5400), (5346, 5342), (5346, 0), (0, 0)]

def windowCases : List (Nat × Nat) := [(574, 575), (670, 671), (100, 100), (40, 575)]

def goldenLines (_ : Unit := ()) : List String :=
  [(Json.mkObj [("op", "consts"), ("windowReach", windowReach), ("endWinFrames", endWinFrames), ("windowTail", windowTail), ("touchTail", touchTail)]).compress] ++
  swipes.map (fun s => (Json.mkObj [("op", "tail"), ("input", swipeJson s), ("idleFrames", s.idleFrames), ("tail", s.tail)]).compress) ++
  (swipes.flatMap fun s => stopCases.map fun (e, nf) =>
    (Json.mkObj [("op", "stopAt"), ("input", swipeJson s), ("end", e), ("fired", nf), ("stopAt", s.stopAt e nf)]).compress) ++
  (swipes.flatMap fun s => stopsCases.map fun (e, n, d) =>
    (Json.mkObj [("op", "stops"), ("input", swipeJson s), ("end", e), ("n", n), ("done", toJson d), ("stops", toJson (s.stops e n d))]).compress) ++
  endFrameCases.map (fun (n, idle) => (Json.mkObj [("op", "endFrame"), ("n", n), ("idle", idle), ("end", endFrameOf n idle)]).compress) ++
  reasonCases.map (fun (limit, y) => (Json.mkObj [("op", "reason"), ("limit", limit), ("y", y), ("reason", endReason limit y)]).compress) ++
  (windowCases.flatMap fun (e, eRun) =>
    swipes.map fun s =>
      let last := eRun + s.tail + 1
      (Json.mkObj [("op", "windows"), ("input", swipeJson s), ("readerEnd", e), ("end", eRun), ("last", last),
        ("total", last + touchTail),
        ("windows", Json.arr ((allWindows e (lastFrame (last + touchTail) touchTail)).toArray.map fun w =>
          Json.mkObj [("name", Json.str w.name), ("lo", toJson w.lo), ("hi", toJson w.hi)]))]).compress)

def goldenText (_ : Unit := ()) : String := String.intercalate "" (goldenLines.map (· ++ "\n"))

def check (path : System.FilePath) : IO Unit := do
  let cur ← IO.FS.readFile path
  unless cur == goldenText do throw (IO.userError s!"swipe-end golden: {path} differs from the generated bytes")
  IO.println s!"swipe-end golden: {path} is up to date ({goldenLines.length} lines)"

def goldenPath : System.FilePath := ".." / "packages" / "contracts" / "golden" / "measure" / "swipe-end.jsonl"

def checkRepo : IO Unit := check goldenPath

def write (path : System.FilePath) : IO Unit := IO.FS.writeFile path goldenText

#guard swipeTouchV1.tail == 165
#guard swipeTouchV1.stopAt 575 575 == 740
#guard swipeTouchV1.stopAt 575 739 == 740
#guard swipeTouchV1.stops 575 739 true == false
#guard swipeTouchV1.stops 575 740 true == true

end Fw.Measure.SwipeEndGolden
