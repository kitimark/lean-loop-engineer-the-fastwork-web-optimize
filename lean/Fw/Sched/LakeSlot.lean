import Fw.Sched.Admit

/-!
# Machine-wide Lake build slots (task `lake-build-slots`): the thread pool of each slot `scripts/lake-slot.sh` hands out
A Lake build or `check.sh` stage 2 takes the first free slot (`pick`); it runs at most one lean process per pool thread.
-/
namespace Fw.Sched.LakeSlot

open Fw.Sched.Admit

/-- Lean's default thread pool on the dev Mac: `hardware_concurrency()` of its 8 cores. -/
def hw : Nat := 8

/-- The thread pool of a slot: the caller's full pool (`LEAN_NUM_THREADS` left as it is) or a cap. -/
inductive Pool where
  | full
  | cap (t : Nat)
deriving DecidableEq, Repr

/-- The pool of each slot, in the order the wrapper tries the slot files. -/
def pools : List Pool := [.full, .cap (hw / 2)]

/-- The number of slot files. -/
def S : Nat := pools.length

/-- The pool of slot `i` (an index past the last slot gets no threads). -/
def poolAt (i : Nat) : Pool := pools.getD i (.cap 0)

/-- Threads of a pool on a machine whose full pool is `n`. -/
def threads (n : Nat) : Pool → Nat
  | .full => n
  | .cap t => t

/-- The full-pool tokens a pool holds (Admit's `cleanBuild` resource): at most one build runs with the full pool. -/
def token : Pool → Nat
  | .full => 1
  | .cap _ => 0

/-- Total pool threads when every slot is held. -/
def bound (n : Nat) : Nat := ((List.range S).map fun i => threads n (poolAt i)).sum

/-- The Admit budget of the Lake builds: `bound n` threads (in tenths of a core) and the one full-pool token. -/
def budget (n : Nat) : Vec := { cores := 10 * bound n, cleanBuild := 1 }

/-- The build holding slot `i` as an Admit item: its pool threads (in tenths of a core) and its token. -/
def item (n i : Nat) : Item :=
  { id := s!"lake-slot-{i}", seq := i, demand := { cores := 10 * threads n (poolAt i), cleanBuild := token (poolAt i) } }

/-- The first free slot in the wrapper's order while the slots in `held` are busy; `none`: the build waits. -/
def pick (held : List Nat) : Option Nat := (List.range S).find? (· ∉ held)

/-- Processes one stage-2 job of `lean/scripts/check.sh` runs at once: a `lean` call, a Lean-built binary, or a sequence of them. -/
def perJob : Nat := 1

/-- Stage-2 jobs `lean/scripts/check.sh` runs at once while it holds slot `i`. -/
def width (i : Nat) : Nat := threads hw (poolAt i) / perJob

/-- Stage-2 jobs at once in slot `i` on a machine with `cores` online cores: `width i`, at most one per core, at least 1. -/
def stage2Width (i cores : Nat) : Nat := min (width i) (max cores 1)

/-- `(slot, online cores)` pairs whose `stage2Width` the generated file lists for the shell test. -/
def widthCases : List (Nat × Nat) := [(0, 0), (0, 1), (0, 4), (0, 8), (0, 16), (1, 0), (1, 2), (1, 4), (1, 8)]

/-- What holds a slot: a Lake build (`lake_slot`) or the stage-2 job group of `check.sh` (`lake_slot_hold`). -/
inductive Holder where
  | build
  | stage2
deriving DecidableEq, Repr

/-- Lean processes a holder of slot `i` runs at once on the dev Mac. -/
def procs : Holder → Nat → Nat
  | .build, i => threads hw (poolAt i)
  | .stage2, i => width i * perJob

/-- The pool as the generated shell file spells it. -/
def render : Pool → String
  | .full => "full"
  | .cap t => toString t

/-- Path of the generated constants, from `lean/`. -/
def genPath : System.FilePath := "../packages/contracts/golden/sched/lake-slot.gen.sh"

/-- The generated constants that `scripts/lake-slot-lib.sh` sources. -/
def genText : String :=
  "# GENERATED by Fw.Sched.LakeSlot.gen (lean/Fw/Sched/LakeSlot.lean); do not edit.\n" ++
  "# Regenerate from lean/: printf 'import Fw.Sched.LakeSlot\\n#eval Fw.Sched.LakeSlot.gen []\\n' | lake env lean --stdin\n" ++
  s!"LAKE_SLOT_POOLS='{" ".intercalate (pools.map render)}'\n" ++
  s!"LAKE_SLOT_BOUND={bound hw}\n" ++
  s!"LAKE_SLOT_WIDTHS='{" ".intercalate ((List.range S).map fun i => toString (width i))}'\n" ++
  s!"LAKE_SLOT_WIDTH_CASES='{" ".intercalate (widthCases.map fun (i, c) => s!"{i}:{c}:{stage2Width i c}")}'\n"

/-- Write `genPath`, or with `--check` throw when the file differs from `genText`. -/
def gen (args : List String) : IO Unit := do
  if args.contains "--check" then
    let cur ← IO.FS.readFile genPath
    if cur != genText then
      throw (IO.userError s!"lake-slot: {genPath} is stale; regenerate with Fw.Sched.LakeSlot.gen []")
    IO.println s!"lake-slot: {genPath} equals the Lean output"
  else
    IO.FS.writeFile genPath genText

/-! ## Proofs -/

theorem sum_le_of_nodup {f : Nat → Nat} :
    ∀ {l L : List Nat}, l.Nodup → (∀ x ∈ l, x ∈ L) → (l.map f).sum ≤ (L.map f).sum
  | [], _, _, _ => Nat.zero_le _
  | a :: t, L, hn, hs => by
    have ha : a ∈ L := hs a (List.mem_cons_self ..)
    have hp : (L.map f).sum = f a + ((L.erase a).map f).sum := by
      have := ((List.perm_cons_erase ha).map f).sum_nat
      simpa using this
    rw [List.nodup_cons] at hn
    have ih := sum_le_of_nodup (f := f) (L := L.erase a) hn.2 fun x hx =>
      (List.mem_erase_of_ne (fun h => hn.1 (by rw [← h]; exact hx))).2 (hs x (List.mem_cons_of_mem _ hx))
    simp only [List.map_cons, List.sum_cons]
    omega

theorem bound_eq (n : Nat) : bound n = n + hw / 2 := by
  simp [bound, S, pools, poolAt, threads, List.range_succ, hw]

theorem bound_hw : bound hw = 12 := by decide

theorem S_eq : S = 2 := rfl

/-- Slot 0 keeps the full pool. -/
theorem solo_full (n : Nat) : poolAt 0 = .full ∧ threads n (poolAt 0) = n := ⟨rfl, rfl⟩

theorem slot1_cap : poolAt 1 = .cap (hw / 2) := rfl

theorem past_last (i : Nat) (h : S ≤ i) : poolAt i = .cap 0 := by
  simp only [poolAt, List.getD_eq_getElem?_getD, List.getElem?_eq_none (show pools.length ≤ i from h), Option.getD_none]

/-- Builds on distinct slots hold at most `bound n` pool threads. -/
theorem held_threads_le (n : Nat) {hs : List Nat} (hn : hs.Nodup) (hr : ∀ i ∈ hs, i < S) :
    (hs.map fun i => threads n (poolAt i)).sum ≤ bound n :=
  sum_le_of_nodup hn fun i hi => List.mem_range.2 (hr i hi)

/-- At the dev Mac's pool, builds on distinct slots hold at most 12 pool threads. -/
theorem held_threads_le_12 {hs : List Nat} (hn : hs.Nodup) (hr : ∀ i ∈ hs, i < S) :
    (hs.map fun i => threads hw (poolAt i)).sum ≤ 12 :=
  bound_hw ▸ held_threads_le hw hn hr

theorem used_map (n : Nat) (r : Res) :
    ∀ hs : List Nat, used (hs.map (item n)) r = (hs.map fun i => (item n i).demand.get r).sum
  | [] => rfl
  | i :: hs => by simp [used, used_map n r hs]

theorem all_slots_used (n : Nat) (r : Res) :
    ((List.range S).map fun i => (item n i).demand.get r).sum = (budget n).get r := by
  cases r <;> simp [item, budget, Vec.get, bound, S, pools, poolAt, threads, token, List.range_succ] <;> omega

/-- Builds on distinct slots fit the Admit budget at every resource (`Fw.Sched.Admit.fits` of the running set). -/
theorem held_within_budget (n : Nat) {hs : List Nat} (hn : hs.Nodup) (hr : ∀ i ∈ hs, i < S) (r : Res) :
    used (hs.map (item n)) r ≤ (budget n).get r := by
  rw [used_map, ← all_slots_used n r]
  exact sum_le_of_nodup hn fun i hi => List.mem_range.2 (hr i hi)

theorem all_slots_used_cores (n : Nat) : used ((List.range S).map (item n)) .cores = (budget n).cores := by
  rw [used_map]; exact all_slots_used n .cores

/-- With every slot held, Admit queues any further build that needs a thread. -/
theorem further_waits (n : Nat) (x : Item) (hx : 0 < x.demand.cores) :
    admit (budget n) { run := (List.range S).map (item n) } x ≠ .admit := by
  intro h
  have hf := ((admit_iff _ _ _).1 h).2.2.1
  simp only [fits, List.all_eq_true, decide_eq_true_eq] at hf
  have := hf .cores (Res.mem_all _)
  rw [all_slots_used_cores] at this
  simp only [Vec.get] at this
  omega

/-- While slot 0 runs, Admit queues a second build that asks for the full-pool token. -/
theorem second_full_waits (n : Nat) (x : Item) (hx : 0 < x.demand.cleanBuild) :
    admit (budget n) { run := [item n 0] } x ≠ .admit := by
  intro h
  have hf := ((admit_iff _ _ _).1 h).2.2.1
  simp only [fits, List.all_eq_true, decide_eq_true_eq] at hf
  have := hf .cleanBuild (Res.mem_all _)
  simp [used, item, budget, Vec.get, poolAt, pools, token] at this
  omega

/-- A picked slot is a slot file that no running build holds. -/
theorem pick_free {held : List Nat} {i : Nat} (h : pick held = some i) : i < S ∧ i ∉ held := by
  unfold pick at h
  exact ⟨List.mem_range.1 (List.mem_of_find?_eq_some h), by simpa using List.find?_some h⟩

/-- No pick: every slot is held, so the build waits. -/
theorem pick_none {held : List Nat} (h : pick held = none) : ∀ i < S, i ∈ held := by
  intro i hi
  unfold pick at h
  simpa using List.find?_eq_none.1 h i (List.mem_range.2 hi)

/-- A solo build gets slot 0, the full pool. -/
theorem pick_solo : pick [] = some 0 := rfl

/-- Builds that each took the slot `pick` chose hold distinct slots, so they stay within `bound n` threads. -/
theorem pick_within_bound (n : Nat) {held : List Nat} {i : Nat} (hn : held.Nodup) (hr : ∀ j ∈ held, j < S)
    (h : pick held = some i) : ((i :: held).map fun j => threads n (poolAt j)).sum ≤ bound n := by
  have ⟨hi, hni⟩ := pick_free h
  refine held_threads_le n (List.nodup_cons.2 ⟨hni, hn⟩) fun j hj => ?_
  rcases List.mem_cons.1 hj with rfl | hj
  · exact hi
  · exact hr j hj

theorem width_mul_le (i : Nat) : width i * perJob ≤ threads hw (poolAt i) := Nat.div_mul_le_self _ _

theorem procs_build (i : Nat) : procs .build i = threads hw (poolAt i) := rfl

theorem procs_stage2 (i : Nat) : procs .stage2 i ≤ threads hw (poolAt i) := width_mul_le i

theorem procs_le : ∀ (h : Holder) (i : Nat), procs h i ≤ threads hw (poolAt i)
  | .build, _ => Nat.le_refl _
  | .stage2, i => procs_stage2 i

theorem width_eq : width 0 = hw ∧ width 1 = hw / 2 := ⟨rfl, rfl⟩

theorem sum_map_le {α : Type} {f g : α → Nat} (h : ∀ a, f a ≤ g a) : ∀ l : List α, (l.map f).sum ≤ (l.map g).sum
  | [] => Nat.le_refl _
  | a :: t => by simp only [List.map_cons, List.sum_cons]; exact Nat.add_le_add (h a) (sum_map_le h t)

/-- Holders of distinct slots, Lake builds and `check.sh` stage-2 groups alike, run at most `bound hw` lean processes. -/
theorem holders_within_bound {hs : List (Nat × Holder)} (hn : (hs.map Prod.fst).Nodup) (hr : ∀ p ∈ hs, p.1 < S) :
    (hs.map fun p => procs p.2 p.1).sum ≤ bound hw := by
  have hm := sum_map_le (fun p : Nat × Holder => procs_le p.2 p.1) hs
  have hb := held_threads_le hw hn fun i hi => by
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hi
    exact hr p hp
  rw [List.map_map] at hb
  exact Nat.le_trans hm hb

/-- A full `check.sh` stage 2 next to any build on the other slot stays within the generated `LAKE_SLOT_BOUND`. -/
theorem stage2_with_build (i j : Nat) (hij : i ≠ j) (hi : i < S) (hj : j < S) :
    procs .stage2 i + procs .build j ≤ 12 := by
  have := holders_within_bound (hs := [(i, .stage2), (j, .build)]) (by simp [hij]) (by simp [hi, hj])
  simpa [bound_hw] using this

theorem stage2Width_le_width (i cores : Nat) : stage2Width i cores ≤ width i := Nat.min_le_left _ _

theorem stage2Width_le_cores (i : Nat) {cores : Nat} (h : 0 < cores) : stage2Width i cores ≤ cores := by
  have := Nat.min_le_right (width i) (max cores 1)
  simp only [stage2Width]; omega

/-- Every slot's gate admits a job, so a stage-2 group always makes progress. -/
theorem stage2Width_pos {i : Nat} (cores : Nat) (hi : i < S) : 0 < stage2Width i cores := by
  have hw0 : 0 < width i := by
    rcases i with _ | _ | i
    · decide
    · decide
    · rw [S_eq] at hi; omega
  simp only [stage2Width]; omega

/-- A full `check.sh` stage 2 at its capped width next to any build on the other slot stays within `LAKE_SLOT_BOUND`. -/
theorem capped_stage2_with_build (i j cores : Nat) (hij : i ≠ j) (hi : i < S) (hj : j < S) :
    stage2Width i cores * perJob + procs .build j ≤ 12 := by
  have := stage2_with_build i j hij hi hj
  have := Nat.mul_le_mul_right perJob (stage2Width_le_width i cores)
  simp only [procs] at *; omega

#guard pick [] == some 0 && pick [0] == some 1 && pick [1] == some 0 && pick [0, 1] == none && pick [1, 0] == none
#guard threads 8 .full == 8 && threads 8 (.cap 4) == 4
#guard token .full == 1 && token (.cap 4) == 0
#guard poolAt 0 == .full && poolAt 1 == .cap 4 && poolAt 2 == .cap 0
#guard render .full == "full" && render (.cap 4) == "4"
#guard bound hw == 12 && S == 2
#guard admit (budget hw) {} (item hw 0) == .admit
#guard admit (budget hw) { run := [item hw 0] } (item hw 1) == .admit
#guard admit (budget hw) { run := [item hw 1] } (item hw 0) == .admit
#guard admit (budget hw) { run := [item hw 0, item hw 1] } { id := "c", demand := { cores := 10 } } ==
  .queue (.overBudget .cores 10 0)
#guard admit (budget hw) { run := [item hw 0] } (item hw 0) == .queue (.overBudget .cores 80 40)
#guard width 0 == 8 && width 1 == 4 && width 2 == 0 && perJob == 1
#guard procs .build 0 == 8 && procs .stage2 0 == 8 && procs .build 1 == 4 && procs .stage2 1 == 4
#guard procs .stage2 0 + procs .build 1 == bound hw && procs .build 0 + procs .stage2 1 == bound hw
#guard stage2Width 0 4 == 4 && stage2Width 0 16 == 8 && stage2Width 0 0 == 1 && stage2Width 1 2 == 2 && stage2Width 1 8 == 4
#guard ((genText.splitOn "\n").take 6).drop 2 ==
  ["LAKE_SLOT_POOLS='full 4'", "LAKE_SLOT_BOUND=12", "LAKE_SLOT_WIDTHS='8 4'",
    "LAKE_SLOT_WIDTH_CASES='0:0:1 0:1:1 0:4:4 0:8:8 0:16:8 1:0:1 1:2:2 1:4:4 1:8:4'"]

end Fw.Sched.LakeSlot
