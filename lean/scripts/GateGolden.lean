import Fw.Gate.Exit
import Fw.Gate.Freeze

/-- Check `packages/contracts/golden/gate/exit.jsonl` and `freeze.jsonl` against the Lean output (the gate's exit and
frozen-clock decisions). Run from `lean/`: `lake env lean --run scripts/GateGolden.lean --check`. -/
def main (_args : List String) : IO UInt32 := do
  let exit ← IO.FS.readBinFile "../packages/contracts/golden/gate/exit.jsonl"
  let want := (String.intercalate "" (Fw.Gate.Exit.goldenLines.map (· ++ "\n"))).toUTF8
  let a : UInt32 := if exit.data == want.data then 0 else 1
  if a == 1 then IO.eprintln "exit golden: exit.jsonl differs from the generated bytes"
  else IO.eprintln "exit golden: exit.jsonl is up to date"
  let b ← Fw.Gate.Freeze.run ["--check", "../packages/contracts/golden/gate/freeze.jsonl"]
  return if a == 0 && b == 0 then 0 else 1
