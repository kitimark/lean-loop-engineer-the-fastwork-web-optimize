  "signature":
  "Fw.Lease.release_fifo (s : Fw.Lease.State) (l : Fw.Lease.Lease) (o : Fw.Lease.Owner) (q : List Fw.Lease.Owner)\n  (now ttl : Nat) (hl : s.holder = some l) (hq : s.queue = o :: q) :\n  (Fw.Lease.step s (Fw.Lease.Cmd.release l.owner now ttl)).fst =\n    { holder := some { owner := o, expires := now + ttl }, queue := q }",
