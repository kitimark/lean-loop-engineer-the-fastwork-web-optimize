   "tex": "\\big(\\forall i\\in(j,j{+}n]:\\ g_i=g_j\\big)\\wedge t_j+\\delta+d\\le t_{j+n}\\ \\Rightarrow\\ \\mathrm{shown}_{j+n}=g_{j+n}"
