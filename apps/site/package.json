{
  "name": "@fw/site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "node scripts/check-breakpoints.mjs && node scripts/gen-shells.mjs --check && node scripts/build.mjs --engine aot",
    "build:runtime": "node scripts/check-breakpoints.mjs && node scripts/build.mjs --engine runtime",
    "build:all": "node scripts/check-breakpoints.mjs && node scripts/build.mjs --engine aot && node scripts/build.mjs --engine runtime",
    "gen:breakpoints": "cd ../../lean && lake exe breakgen > ../apps/site/src/breakpoints.gen.json",
    "check:breakpoints": "node scripts/check-breakpoints.mjs",
    "gen:shells": "node scripts/gen-shells.mjs",
    "check:shells": "node scripts/gen-shells.mjs --check",
    "check:shell-boxes": "node scripts/shell-measure.mjs check",
    "census": "node scripts/census.mjs",
    "gen:svg": "node scripts/svg-extract.mjs",
    "pretest": "node scripts/svg-extract.mjs",
    "prebuild": "node scripts/svg-extract.mjs",
    "prebuild:runtime": "node scripts/svg-extract.mjs",
    "prebuild:all": "node scripts/svg-extract.mjs",
    "pretypecheck": "node scripts/svg-extract.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@mui/styled-engine": "9.5.0",
    "@mui/system": "9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "puppeteer-core": "25.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
